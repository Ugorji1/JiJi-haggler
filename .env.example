# ==============================================================================
# Jiji AI Marketplace Haggler (Universal Engine) - Environment Configuration
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Google Gemini API Key (Required for AI Negotiation)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (Fallback provider)
OPENAI_API_KEY=

# Telegram Bot Notification & Approval Gate (Optional but Recommended)
# 1. Talk to @BotFather on Telegram to create your bot and obtain the token.
# 2. Start your bot and message @userinfobot to obtain your numeric Chat ID.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Azza Payout Gateway Configuration (Optional)
AZZA_PHONE_NUMBER=2349000000000
RATE_NGN=1520
RATE_KES=130
